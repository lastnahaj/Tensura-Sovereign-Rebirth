      "pack_manifest": "pack/mods/beyond-adventures.pw.toml",
      "digest": "db5951096dceba302ae36cea58d140c462fbe91b92948c7e57266e63988afb9a5ac584f7d7cacc8e5c5f7bdf69a12d32c8d1abd71dd9ac988264d3fe5e95876b",
      "source_url": "https://modrinth.com/mod/beyond-adventures/version/Ybm5N8pk",
      "summary": "Adventure-contract controls, daily reward display settings, quest-day maintenance, and a movement repair tool.",
      "entries": [
        {"command": "/beyondadv announceContracts enabled <bool>", "access": "Admin", "purpose": "Enable or disable contract announcements.", "branches": [], "evidence": "com/trbeyond/quest/command/BeyondAdvCommands.class"},
        {"command": "/beyondadv dailyrewardpopup enabled <bool>", "access": "Mixed", "purpose": "Control the daily reward popup preference.", "branches": [], "evidence": "com/trbeyond/quest/command/BeyondAdvCommands.class"},
        {"command": "/beyondadv forcerecall <target>", "access": "Admin", "purpose": "Recall deployed character contracts belonging to the target player.", "branches": [], "evidence": "com/trbeyond/quest/command/BeyondAdvCommands.class"},
        {"command": "/beyondadv quest day …", "access": "Admin", "purpose": "Inspect, set, or add Beyond's stored quest day.", "branches": ["get", "set <day>", "add <days>"], "evidence": "com/trbeyond/quest/command/BeyondAdvCommands.class"},
        {"command": "/beyondadv quest mxp reset", "access": "Admin", "purpose": "Reset the stored MXP schedule state.", "branches": [], "evidence": "com/trbeyond/quest/command/BeyondAdvCommands.class"},
        {"command": "/characterMovementFix <target>", "access": "Gamemaster", "purpose": "Clear lingering movement-interference effects from a Beyond character entity.", "branches": [], "evidence": "com/trbeyond/command/GachaLingeringEffectFixCommand.class"}
      ]
    },
    {
      "id": "nightmares",
      "name": "Tensura Nightmares",
      "version": "1.0.3.2.8",
      "minecraft": "1.21.1",
      "status": "Reference build · server match pending",
      "digest": "94b37573cb247ed060c81a0c90a37a7258ab3517d6ad64c0e85902cd7da64127",
      "source_url": "https://www.curseforge.com/minecraft/mc-mods/tensura-reincarnated-nightmares/files/8679382",
      "summary": "A large command surface for souls, deals, titles, egos, faiths, families, Domiciles, stats, skill evolution, and EMC integration.",
      "entries": [
        {"command": "/trnightmare …", "access": "Mixed", "purpose": "Primary Nightmares tree for soul inspection, controls, Deal Maker operations, memory tools, Raphael tools, and staff utilities.", "branches": ["elementsoul", "soultrait", "checksoul", "control", "dealcreate", "dealmaker", "info", "memoryseal|memoryundo", "raphael_name|raphaelsocial", "investigate", "pack"], "evidence": "com/github/hvnbael/trnightmare/main/command/NightmareCommands.class"},
        {"command": "/skill …", "access": "Mixed", "purpose": "Inspect, confirm, or administratively force Nightmares skill-evolution paths.", "branches": ["checkevoconditions", "evolutionconfirm", "forceskillevolution"], "evidence": "com/github/hvnbael/trnightmare/main/command/SkillEvolutionCommands.class"},
        {"command": "/qol stats …", "access": "Mixed", "purpose": "View or edit existence and Minecraft statistic values through the Nightmares quality-of-life tree.", "branches": ["overview", "target", "existence list|get|set|add", "minecraft list|get|set"], "evidence": "com/github/hvnbael/trnightmare/main/command/QOLCommands.class"},
        {"command": "/stat …", "access": "Admin", "purpose": "Administer Nihility, Spiritrons, and entity-awakening state.", "branches": ["nihility add|set", "spiritrons add|set", "entityawakening status|enforce"], "evidence": "com/github/hvnbael/trnightmare/main/command/StatCommands.class"},
        {"command": "/title …", "access": "Mixed", "purpose": "List, activate, or clear owned titles; staff branches grant, create, and remove titles.", "branches": ["list", "activate <id>", "clear", "admin grant|create|remove"], "evidence": "com/github/hvnbael/trnightmare/main/command/TitleCommand.class"},
        {"command": "/ego …", "access": "Mixed", "purpose": "Spawn, rename, inspect, mute, edit, or administer ego and Manas state.", "branches": ["spawn", "respawn", "rename", "stat", "mute", "name", "edit", "clear-all", "admin"], "evidence": "com/github/hvnbael/trnightmare/main/command/EgoCommands.class"},
        {"command": "/faith …", "access": "Mixed", "purpose": "Create, join, list, inspect, or administer Nightmares faith organizations.", "branches": ["list", "join", "create", "faithful name", "admin"], "evidence": "com/github/hvnbael/trnightmare/main/command/FaithCommand.class"},
        {"command": "/family …", "access": "Player", "purpose": "Create a family, invite players, accept invitations, and list members.", "branches": ["create <name>", "invite <player>", "accept", "list"], "evidence": "com/github/hvnbael/trnightmare/main/command/FamilyCommand.class"},
        {"command": "/dragonrelation …", "access": "Admin", "purpose": "Read, add, or set a player's relationship score for a named True Dragon.", "branches": ["get", "add <amount>", "set <amount>"], "evidence": "com/github/hvnbael/trnightmare/main/command/DragonRelationCommand.class"},
        {"command": "/dragonname …", "access": "Player", "purpose": "Attempt a True Dragon surname action when its relationship and resource requirements are satisfied.", "branches": ["<dragon> surname <name>"], "evidence": "com/github/hvnbael/trnightmare/main/command/DragonNameCommand.class"},
        {"command": "/awaken …", "access": "Mixed", "purpose": "Check awakening progress or force an allowed awakening type through the protected branch.", "branches": ["check", "awakening <type>"], "evidence": "com/github/hvnbael/trnightmare/main/command/AwakeningCommand.class"},
        {"command": "/TrueDragonNucleation …", "access": "Player", "purpose": "Use Azathoth's True Dragon Nucleation operation for an eligible named dragon.", "branches": ["sacrifice <dragon>"], "evidence": "com/github/hvnbael/trnightmare/main/command/AzathothCommand.class"},
        {"command": "/domicile …", "access": "Mixed", "purpose": "Manage Domicile access, kicking, locking, safety, and allow/block lists.", "branches": ["whitelist add|remove|list", "blacklist add|remove|list", "kick", "lock", "togglesafety"], "evidence": "com/github/hvnbael/trnightmare/main/command/DomicileCommand.class"},
        {"command": "/domicilestore …", "access": "Mixed", "purpose": "Manage the corresponding Domicile store access controls.", "branches": ["whitelist", "blacklist", "kick", "lock", "togglesafety"], "evidence": "com/github/hvnbael/trnightmare/main/command/DomicileCommand.class"},
        {"command": "/resetdomicile …", "access": "Admin", "purpose": "Reset selected Domicile regions or generated components.", "branches": ["base", "shop", "canino"], "evidence": "com/github/hvnbael/trnightmare/main/command/DomicileCommand.class"},
        {"command": "/setSelfName <name>", "access": "Player", "purpose": "Set the preferred self-name used by compatible Nightmares systems.", "branches": [], "evidence": "com/github/hvnbael/trnightmare/main/command/SelfNameCommand.class"},
        {"command": "/deal …", "access": "Mixed", "purpose": "Inspect, confirm, end, claim, or administer soul deals and their inventories.", "branches": ["<uuid>", "confirm", "end", "souldeal", "soulinventory", "soulvomit", "acceptdealfor", "forcedealbreak", "stealsoul"], "evidence": "com/github/hvnbael/trnightmare/main/command/DealCommand.class"},
        {"command": "/emc · /knowledge · /showbag …", "access": "Mixed", "purpose": "Nightmares' packaged EMC, knowledge, and Alchemical Bag command integration.", "branches": ["emc add|remove|set|get|test", "knowledge learn|unlearn|test|clear", "showbag"], "evidence": "com/github/hvnbael/trnightmare/emc/pe/network/commands/"},
        {"command": "/setemc · /removeemc · /resetemc · /dumpmissingemc …", "access": "Admin", "purpose": "Protected EMC value maintenance and missing-value diagnostics.", "branches": [], "evidence": "com/github/hvnbael/trnightmare/emc/pe/network/commands/"}
      ],
      "note": "This command list is verified against the named 1.21.1 reference release. The exact Nightmares jar deployed by TSR is not yet recorded in the current pack manifest, so availability on the live server must be confirmed with tab completion."
    },
