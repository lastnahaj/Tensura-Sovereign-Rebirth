{
  "schema": 1,
  "legend": {
    "Player": "Available from ordinary player command paths.",
    "Mixed": "Contains player-facing branches and protected staff branches.",
    "Moderator": "Requires moderator-level permission for target inspection.",
    "Gamemaster": "Protected operator command used to modify gameplay state.",
    "Owner": "Highest-permission maintenance command.",
    "Admin": "Protected administrative or diagnostic command."
  },
  "sources": [
    {
      "id": "tensura",
      "name": "Tensura: Reincarnated",
      "version": "2.0.1.2",
      "minecraft": "1.21.1",
      "status": "Installed",
      "pack_manifest": "pack/mods/tensura-reincarnated.pw.toml",
      "digest": "f6f0c8ce46b77a1996c5986d029411878142112f",
      "source_url": "https://www.curseforge.com/minecraft/mc-mods/tensura-reincarnated/files/8665599",
      "summary": "Core player controls plus moderator, gamemaster, and world-management tools.",
      "entries": [
        {"command": "/ability …", "access": "Player", "purpose": "Manage ability presets, slots, skill toggles, skill locks, spatial movement, and spatial storage.", "branches": ["preset name|set", "set", "toggle", "toggle all|random", "lock add|remove|clear|list", "spatial warp|portal|storage"], "evidence": "io/github/manasmods/tensura/command/AbilityCommand.class"},
        {"command": "/evolve …", "access": "Player", "purpose": "Attempt a race evolution or eligible demon-lord or hero awakening route.", "branches": ["race", "demonLord", "hero"], "evidence": "io/github/manasmods/tensura/command/EvolveCommand.class"},
        {"command": "/nameable", "access": "Player", "purpose": "Toggle whether the player can receive a name through Tensura's naming system.", "branches": [], "evidence": "io/github/manasmods/tensura/command/NameCommand.class"},
        {"command": "/tensura get …", "access": "Mixed", "purpose": "Inspect ability, awakening, owner, race, spirit, and stat data. Self queries are player-facing; target inspection is protected.", "branches": ["ability", "awakening", "owner", "race", "spirit", "stat"], "evidence": "io/github/manasmods/tensura/command/TensuraCommands$TensuraCommand$TensuraGetCommand.class"},
        {"command": "/tensura edit …", "access": "Gamemaster", "purpose": "Edit or reset abilities, owners, races, spirits, awakening state, and existence stats.", "branches": ["ability", "owner", "race", "reset", "spirit", "stat"], "evidence": "io/github/manasmods/tensura/command/TensuraCommands$TensuraCommand$TensuraEditCommand.class"},
        {"command": "/tensura worldData …", "access": "Admin", "purpose": "Manage persistent world systems and restrictions.", "branches": ["bossFight", "areaMagicule", "labyrinth", "trulyUnique", "warpPad", "worldRestriction"], "evidence": "io/github/manasmods/tensura/command/TensuraCommands$TensuraCommand$WorldDataCommand.class"},
        {"command": "/engrave …", "access": "Gamemaster", "purpose": "Apply a selected enchantment level to held equipment for one or more entities.", "branches": [], "evidence": "io/github/manasmods/tensura/command/EngraveCommand.class"},
        {"command": "/despawn …", "access": "Owner", "purpose": "Discard the selected entities.", "branches": [], "evidence": "io/github/manasmods/tensura/command/DespawnCommand.class"},
        {"command": "/syncStorage …", "access": "Owner", "purpose": "Force selected entity capability storage to synchronize.", "branches": [], "evidence": "io/github/manasmods/tensura/command/SyncCommand.class"}
      ]
    },
    {
      "id": "mysticism",
      "name": "Tensura: Mysticism",
      "version": "2.1.2",
      "minecraft": "1.21.1",
      "status": "Installed",
      "pack_manifest": "pack/mods/tensura-mysticism.pw.toml",
      "digest": "cca1bd878b46c21ddbbf507bd4489fbb217899c7",
      "source_url": "https://www.curseforge.com/minecraft/mc-mods/tensura-mysticism/files/8379529",
      "summary": "The current build registers only Soul Energy stat inspection and editing beneath the Mysticism root.",
      "entries": [
        {"command": "/mysticism get stat …", "access": "Mixed", "purpose": "Read current or maximum Soul Energy for yourself or an allowed target.", "branches": ["current soulEnergy", "max soulEnergy"], "evidence": "io/github/Memoires/mysticism/command/get/MysticGetStatCommand.class"},
        {"command": "/mysticism edit stat …", "access": "Gamemaster", "purpose": "Set, add to, or reset current and maximum Soul Energy values.", "branches": ["current set|add|reset", "max set|add"], "evidence": "io/github/Memoires/mysticism/command/edit/MysticEditStatCommand.class"},
        {"command": "/mysticism edit reset …", "access": "Gamemaster", "purpose": "Reset Soul Energy storage using the selected reset path.", "branches": ["soulEnergy"], "evidence": "io/github/Memoires/mysticism/command/edit/MysticResetCommand.class"}
      ],
      "note": "The old 1.19.2 article lists soul-quality, contract, and spirit reroll commands that are absent from the pinned 2.1.2 command classes. They are intentionally excluded."
    },
    {
      "id": "ascension",
      "name": "Tensura: Ascension",
      "version": "2.1.2",
      "minecraft": "1.21.1",
      "status": "Installed",
      "pack_manifest": "pack/mods/tensura-ascensions.pw.toml",
      "digest": "84cbe87a6641bd8275624f8251eb2b25c57f0bbc",
      "source_url": "https://www.curseforge.com/minecraft/mc-mods/tensura-ascension/files/8060740",
      "summary": "Ultimate-evolution progress inspection and an administrative awakening-cooldown reset.",
      "entries": [
        {"command": "/tascension checkultprogress <ultimate> [player]", "access": "Mixed", "purpose": "Show the tracked requirements and progress for a registered Ascension ultimate skill.", "branches": [], "evidence": "com/simplygray/tensuraaddon/command/AscensionCommands.class"},
        {"command": "/tascension cooldown reset <targets>", "access": "Admin", "purpose": "Clear Ascension's last-awakening cooldown data for selected players.", "branches": [], "evidence": "com/simplygray/tensuraaddon/command/AscensionCommands.class"}
      ]
    },
    {
      "id": "stextras",
      "name": "SlimeThrone Extras",
      "version": "2.1.2.1",
      "minecraft": "1.21.1",
      "status": "Installed",
      "pack_manifest": "pack/mods/tensura-slimethrone-extras.pw.toml",
      "digest": "506354ffcf888c573440cee273f49aa7d72a340c",
      "source_url": "https://www.curseforge.com/minecraft/mc-mods/tensura-slimethrone-extras/files/8313927",
      "summary": "Player progression, quest, prestige, schedule, wiki, and staff-diagnostic commands.",
      "entries": [
        {"command": "/stextras wiki", "access": "Player", "purpose": "Open the SlimeThrone Extras FAQ link supplied by the mod.", "branches": [], "evidence": "org/crypticdev/stextras/command/system/WikiCommands.class"},
        {"command": "/stextras player summary [player]", "access": "Mixed", "purpose": "Display a compact progression summary for yourself or an allowed target.", "branches": [], "evidence": "org/crypticdev/stextras/command/player/PlayerCommands.class"},
        {"command": "/stextras player essence …", "access": "Mixed", "purpose": "Read or administratively change Reincarnation Essence.", "branches": ["get", "set", "add"], "evidence": "org/crypticdev/stextras/command/player/PlayerCommands.class"},
        {"command": "/stextras player soulgrade …", "access": "Mixed", "purpose": "Read or administratively change Soul Grade.", "branches": ["get", "set", "add"], "evidence": "org/crypticdev/stextras/command/player/PlayerCommands.class"},
        {"command": "/stextras player locked-skills …", "access": "Mixed", "purpose": "List or manage the ordinary skill-lock pool.", "branches": ["list", "lock <id>", "unlock <id>", "clear"], "evidence": "org/crypticdev/stextras/command/player/PlayerCommands.class"},
        {"command": "/stextras player admin-locked-skills …", "access": "Admin", "purpose": "Manage skills locked by staff policy.", "branches": ["list", "lock <id>", "unlock <id>", "clear"], "evidence": "org/crypticdev/stextras/command/player/PlayerCommands.class"},
        {"command": "/stextras quests …", "access": "Mixed", "purpose": "Browse quest catalogs and active progress, or run protected quest mutations.", "branches": ["catalog", "summary", "list all|active|completed", "manage add|remove|complete|reset", "repeatable cooldown reset"], "evidence": "org/crypticdev/stextras/command/quest/QuestCommands.class"},
        {"command": "/stextras race prestige …", "access": "Mixed", "purpose": "Inspect race-prestige progress or administratively mark and unmark completions.", "branches": ["races", "player", "quests <id>", "mark-complete <id>", "unmark-complete <id>"], "evidence": "org/crypticdev/stextras/command/quest/RacePrestigeCommands.class"},
        {"command": "/stextras required …", "access": "Admin", "purpose": "Preview or apply the required-quest selection for a prestige count.", "branches": ["preview <prestige>", "apply <prestige> [player]"], "evidence": "org/crypticdev/stextras/command/quest/RequiredCommands.class"},
        {"command": "/stextras schedule …", "access": "Mixed", "purpose": "Inspect daily and weekly reset timing or administer counts, master state, rolls, and player application.", "branches": ["info", "time daily|weekly", "count get|set", "master get|set", "roll daily|weekly|both", "apply self|all", "reset_progress"], "evidence": "org/crypticdev/stextras/command/system/ScheduleCommands.class"},
        {"command": "/stextras debug …", "access": "Admin", "purpose": "Inspect integration state and open test utilities for staff troubleshooting.", "branches": ["open-bench", "check-effects", "soulgrade-levels", "check-lootr"], "evidence": "org/crypticdev/stextras/command/system/DebugCommands.class"}
      ]
    },
    {
      "id": "beyond",
      "name": "TR: Beyond Adventures",
      "version": "1.1.9",
      "minecraft": "1.21.1",
